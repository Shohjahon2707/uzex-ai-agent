LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-20b

# Необязательно: для ротации убери строку LLM_API_KEY выше и раскомментируй свои ключи.
# LLM_API_KEY_1=your_first_key
# LLM_API_KEY_2=your_second_key
# LLM_API_KEY_3=your_third_key
# LLM_API_KEY_4=your_fourth_key
# LLM_API_KEY_5=your_fifth_key
# Проверить порядок без API-запросов: python manage.py check_llm --show-rotation

# После изменения .env перезапусти Django. .env.example приложение не читает.
# Проверка: python manage.py check_llm
# Доступные модели: python manage.py check_llm --list-models
DEBUG=1
